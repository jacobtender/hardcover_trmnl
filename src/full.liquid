{% assign user = data.me[0] %}
{% if user %}
  <div class="layout layout--col layout--left layout--top gap--medium" > 
    <div id="topRow" class="grid grid--cols-2 gap--medium w--full">
      {% render 'profile', image: user.image, name: user.name, username: user.username, bio: user.bio, followed_users_count: user.followed_users_count, followers_count: user.followers_count %}

      {% render 'stat_grid', user: user %}
    </div>

    {% assign featured_area_raw = trmnl.plugin_settings.custom_fields_values.featuredArea | default: 'goals' %}
    {% assign featured_area = featured_area_raw | downcase | replace: ' ', '_' %}
    {% capture title %}{% render 'featured_area_title', area: featured_area %}{% endcapture %}
    {% assign title = title | strip %}
    <div id="bottomRow" class="grid grid--cols-1 w--full">
      {% render 'featured_area', user: user, area: featured_area %}
    </div>
  </div>
      
  {% render 'title_bar', username: user.username, flair: user.flair, librarian: user.librarian_roles, title: title %}
{% else %}
  <div class="layout layout--col layout--center">
    {% render 'hardcover_error', errors: trmnl.errors %}
  </div>

  {% render 'title_bar', title: 'Hardcover Error' %}
{% endif %}
